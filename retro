#!/usr/bin/env bash
set -euo pipefail

CYAN='\033[96m'
GREEN='\033[92m'
RED='\033[91m'
YELLOW='\033[93m'
NC='\033[0m'

show_banner() {
cat << "EOF"
  ____  _____ _____ ____   ___     ___  ____  
 |  _ \| ____|_   _|  _ \ / _ \   / _ \/ ___| 
 | |_) |  _|   | | | |_) | | | | | | | \___ \ 
 |  _ <| |___  | | |  _ <| |_| | | |_| |___) |
 |_| \_\_____| |_| |_| \_\\___/   \___/|____/ 
 Tactical Resilient Operating System
EOF
}

case "${1:-help}" in
    term)
        exec /usr/local/bin/retro-term
        ;;

    doctor)
        echo -e "${YELLOW}[*] Running System Diagnostic & Fix...${NC}"
        echo -e "${CYAN}[1/5] Checking Hardware Drivers...${NC}"
        sudo ubuntu-drivers autoinstall 2>/dev/null || true
        echo -e "${CYAN}[2/5] Cleaning Btrfs Snapshots (Max 3)...${NC}"
        sudo snapper -c root cleanup number 2>/dev/null || true
        sudo snapper -c root cleanup timeline 2>/dev/null || true
        echo -e "${CYAN}[3/5] Fixing Broken Packages...${NC}"
        sudo rm -f /var/lib/apt/lists/lock /var/cache/apt/archives/lock /var/lib/dpkg/lock* 2>/dev/null || true
        sudo dpkg --configure -a 2>/dev/null || true
        sudo apt-get -f install -y 2>/dev/null || true
        echo -e "${CYAN}[4/5] Memory & SSD Trimming...${NC}"
        sudo fstrim -av 2>/dev/null || true
        echo -e "${CYAN}[5/5] Checking EarlyOOM Status...${NC}"
        systemctl is-active earlyoom 2>/dev/null && echo "EarlyOOM Active."
        echo -e "${GREEN}[✓] Diagnostics & System Fix Complete.${NC}"
        ;;
        
    kali)
        echo -e "${YELLOW}[*] Launching Full-Privilege Kali Weapons Bay...${NC}"
        # --root ഫ്ലാഗ് ഉപയോഗിച്ച് ഫുൾ ഹാർഡ്‌വെയർ പെർമിഷൻ നൽകുന്നു
        if ! sudo distrobox list 2>/dev/null | grep -q "retro-kali"; then
            echo -e "${CYAN}[*] Setting up Root Kali Container (Full Hardware Access)...${NC}"
            sudo distrobox create --root --image docker.io/kalilinux/kali-rolling:latest --name retro-kali --nvidia -Y
        fi
        sudo distrobox enter --root retro-kali
        sudo podman stop retro-kali 2>/dev/null || true
        echo -e "${GREEN}[✓] Session Closed. Memory Cleared.${NC}"
        ;;

    burner)
        echo -e "${YELLOW}[*] Creating Temp RAM Sandbox (Zero-Trace)...${NC}"
        B_DIR="/tmp/burner-$(date +%s)"
        mkdir -p "$B_DIR"
        sudo mount -t tmpfs -o size=512m tmpfs "$B_DIR"
        echo -e "${GREEN}[✓] Ready at $B_DIR. Type 'exit' to self-destruct.${NC}"
        (cd "$B_DIR" && bash)
        sudo umount "$B_DIR"
        rm -rf "$B_DIR"
        echo -e "${GREEN}[✓] Sandbox wiped.${NC}"
        ;;

    panic)
        echo -e "${RED}[!] Stealth Panic Triggered...${NC}"
        qdbus org.kde.kglobalaccel /component/kwin invokeShortcut "ShowDesktop" 2>/dev/null || true
        command -v xclip &> /dev/null && echo -n "" | xclip -selection clipboard 2>/dev/null || true
        history -c
        echo -e "${GREEN}[✓] Cleared.${NC}"
        ;;

    snap)
        echo -e "${YELLOW}[*] Creating Instant Safe-Point Snapshot...${NC}"
        sudo snapper -c root create -d "Retro-Backup-$(date +%Y%m%d-%H%M%S)" 2>/dev/null || true
        echo -e "${GREEN}[✓] Snapshot created.${NC}"
        ;;

    ghost)
        if systemctl is-active --quiet tor; then
            sudo systemctl stop tor
            echo -e "${RED}[-] Tor Disabled (Standard Network).${NC}"
        else
            sudo systemctl start tor
            echo -e "${GREEN}[✓] Tor Activated (Ghost Mode).${NC}"
        fi
        ;;

    update)
        echo -e "${YELLOW}[*] Upgrading System & Maintenance...${NC}"
        sudo apt-get update -y && sudo apt-get dist-upgrade -y
        sudo apt-get autoremove -y && sudo apt-get clean
        if sudo distrobox list 2>/dev/null | grep -q "retro-kali"; then
            echo -e "${CYAN}[*] Upgrading Kali Subsystem...${NC}"
            sudo distrobox enter --root retro-kali -- apt-get update -y && apt-get dist-upgrade -y
        fi
        echo -e "${GREEN}[✓] System is completely up to date.${NC}"
        ;;
        
    help|*)
        show_banner
        echo -e "Commands:"
        echo -e "  ${GREEN}retro term${NC}    : Open Retro Terminal"
        echo -e "  ${GREEN}retro doctor${NC}  : Memory/disk clean-up, fix drivers and packages"
        echo -e "  ${GREEN}retro kali${NC}    : Root Kali container with full hardware/WiFi access"
        echo -e "  ${GREEN}retro burner${NC}  : Disposable RAM sandbox"
        echo -e "  ${GREEN}retro snap${NC}    : Save quick restore point"
        echo -e "  ${GREEN}retro ghost${NC}   : Toggle Tor Privacy Mode"
        echo -e "  ${GREEN}retro panic${NC}   : Hide everything instantly"
        echo -e "  ${GREEN}retro update${NC}  : Auto-update system without breakage"
        ;;
esac
