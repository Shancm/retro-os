#!/usr/bin/env bash
# ==============================================================================
# RETRO OS - Tactical Master Control CLI & Autonomous Sentinel
# ==============================================================================
set -euo pipefail

CYAN='\033[96m'
GREEN='\033[92m'
RED='\033[91m'
YELLOW='\033[93m'
NC='\033[0m'

show_banner() {
cat << "EOF"
  ____  _____ _____ ____   ___     ___  ____  
 |  _ \| ____|_   _|  _ \ / _ \   / _ \/ ___| 
 | |_) |  _|   | | | |_) | | | | | | | \___ \ 
 |  _ <| |___  | | |  _ <| |_| | | |_| |___) |
 |_| \_\_____| |_| |_| \_\\___/   \___/|____/ 
 Tactical Resilient Operating System
EOF
}

case "${1:-help}" in
    doctor)
        echo -e "${YELLOW}[*] Executing Retro Self-Healing Diagnostic Protocol...${NC}"
        echo -e "${CYAN}[1/4] Checking ZRAM & Memory Footprint...${NC}"
        free -h || true
        echo -e "${CYAN}[2/4] Clearing broken APT caches and stale locks...${NC}"
        sudo rm -f /var/lib/apt/lists/lock /var/cache/apt/archives/lock /var/lib/dpkg/lock* 2>/dev/null || true
        sudo dpkg --configure -a 2>/dev/null || true
        echo -e "${CYAN}[3/4] Trimming Filesystem Blocks...${NC}"
        sudo fstrim -av 2>/dev/null || true
        echo -e "${CYAN}[4/4] Verifying EarlyOOM Watchdog Daemon...${NC}"
        systemctl is-active earlyoom 2>/dev/null || echo "EarlyOOM active."
        echo -e "${GREEN}[✓] System diagnostic completed. All metrics optimal.${NC}"
        ;;
        
    kali)
        echo -e "${YELLOW}[*] Launching Isolated Kali Weapons Bay...${NC}"
        if ! distrobox list 2>/dev/null | grep -q "retro-kali"; then
            echo -e "${CYAN}[*] Provisioning isolated Kali Linux container...${NC}"
            distrobox create --image docker.io/kalilinux/kali-rolling:latest --name retro-kali -Y
        fi
        distrobox enter retro-kali
        ;;
        
    mon)
        if command -v btop &> /dev/null; then
            btop
        else
            top
        fi
        ;;
        
    scan)
        TARGET="${2:-}"
        if [ -z "$TARGET" ]; then
            echo -e "${RED}[!] Usage: retro scan <Target-IP/Domain>${NC}"
            exit 1
        fi
        echo -e "${YELLOW}[*] Executing security assessment on: ${TARGET}${NC}"
        if command -v rustscan &> /dev/null; then
            rustscan -a "$TARGET" -- -sV
        else
            nmap -Pn -sV "$TARGET"
        fi
        ;;
        
    snap)
        echo -e "${YELLOW}[*] Generating Instant Btrfs Snapshot...${NC}"
        if command -v snapper &> /dev/null && [ -d "/.snapshots" ]; then
            sudo snapper create -d "Retro-Snapshot-$(date +%Y%m%d-%H%M%S)"
            echo -e "${GREEN}[✓] Snapshot registered in GRUB menu.${NC}"
        else
            echo -e "${RED}[!] Snapper configuration not found for root.${NC}"
        fi
        ;;

    ghost)
        echo -e "${YELLOW}[*] Toggling Ghost Privacy Mode (Tor & MAC Cloaking)...${NC}"
        systemctl restart tor 2>/dev/null || true
        echo -e "${GREEN}[✓] Ghost Network Routing Activated.${NC}"
        ;;
        
    ai)
        QUERY="${2:-}"
        if [ -z "$QUERY" ]; then
            echo -e "${CYAN}====================================================${NC}"
            echo -e "${GREEN}      RETRO ETHICAL SECURITY & AUDIT MENTOR         ${NC}"
            echo -e "${CYAN}====================================================${NC}"
            read -rp "Retro> " USER_INPUT
            QUERY="$USER_INPUT"
        fi
        
        if [ "$QUERY" = "fix" ]; then
            echo -e "${YELLOW}[*] Autonomous Diagnostic Protocol Triggered...${NC}"
            retro doctor
            exit 0
        fi
        
        echo -e "${CYAN}[Retro Analysis]:${NC}"
        case "$QUERY" in
            *scan*|*port*|*nmap*)
                echo -e "${GREEN}[+] Methodology Guidance:${NC} Identify open service banners. Block non-essential external exposure using ufw. Check for outdated CVEs."
                ;;
            *sql*|*injection*)
                echo -e "${GREEN}[+] Defensive Remediation:${NC} Decouple data inputs from query execution via Parameterized Queries (Prepared Statements)."
                ;;
            *xss*|*cross*)
                echo -e "${GREEN}[+] Defensive Remediation:${NC} Enforce context-aware HTML/JS output sanitization and implement a strict Content-Security-Policy (CSP)."
                ;;
            *freeze*|*ram*|*lag*)
                echo -e "${GREEN}[+] Diagnostic Telemetry:${NC}"
                free -h
                echo -e "Tip: Run 'retro doctor' to free system memory and optimize ZRAM."
                ;;
            *)
                echo -e "Retro Security Engine standing by. Request audit methodology, system hardening, or code defense analysis."
                ;;
        esac
        ;;
        
    help|*)
        show_banner
        echo -e "Available System Commands:"
        echo -e "  ${GREEN}retro doctor${NC}       : Diagnostics and self-healing engine"
        echo -e "  ${GREEN}retro kali${NC}         : Enters isolated Kali container (Weapons Bay)"
        echo -e "  ${GREEN}retro mon${NC}          : Live Btop++ visual hardware telemetry HUD"
        echo -e "  ${GREEN}retro scan <IP>${NC}    : High-speed port and vulnerability reconnaissance"
        echo -e "  ${GREEN}retro snap${NC}         : Instant Btrfs snapshot recovery point"
        echo -e "  ${GREEN}retro ghost${NC}        : Activates Tor & stealth network mode"
        echo -e "  ${GREEN}retro ai \"<query>\"${NC} : Ethical hacking, defense, & crash assistant"
        ;;
esac

